# Exemple de configuration locale — copier en `.env` (JAMAIS commité, voir .gitignore).
# Ordre de priorité : DEFAULTS < .env < fichier JSON (TRADEHELPER_CONFIG) < variables d'environnement.

# Clé API Alpha Vantage (gratuite, optionnelle — fournisseur de repli pour les actions).
# https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Chemin de la base SQLite (défaut : ~/.local/share/tradehelper/market.db)
# TRADEHELPER_DB_PATH=

# Prix ajustés (dividendes/splits) pour les actions — défaut : 1
# TRADEHELPER_ADJUST_PRICES=1

# Langue de l'interface : fr (défaut) | en
# TRADEHELPER_LANG=fr

# Backend de calcul : auto (défaut) | cpu | cuda
# TRADEHELPER_BACKEND=auto

# JAMAIS de vrai trading sans validation explicite :
# TRADEHELPER_ALLOW_LIVE_TRADING=0   # reste à 0 pour un broker IBKR réel verrouillé
